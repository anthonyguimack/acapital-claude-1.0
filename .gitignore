frontend/build/
frontend/.cache/
dist/

# ── Python ────────────────────────────────────────────────────────────────────
backend/venv/
backend/.venv/
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.eggs/

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.*
*.env
backend/.env
frontend/.env
!frontend/.env.example
!backend/.env.example
*.pem
*.key
*credentials*.json
*token*.json

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
*.err.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Uploaded user content (serve from storage, not git) ───────────────────────
backend/uploads/

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── Claude Code internal state ────────────────────────────────────────────────
.claude/

